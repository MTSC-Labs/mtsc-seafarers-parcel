{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtsc-seafarers-parcel-backend",
  "main": "src/worker.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mtsc-parcel-db",
      "database_id": "mtsc-parcel-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "mtsc-parcel-uploads"
    }
  ]
}
