{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtsc-seafarers-parcel-backend",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "mtsc_parcel_db",
      "database_name": "mtsc-parcel-db",
      "database_id": "8459d0ef-2980-45bf-8912-3d15d970fd3e"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "mtsc-parcel-uploads",
      "binding": "mtsc_parcel_uploads"
    }
  ],
 "vars": {
    "BACKEND_URL": "https://parcelservice.mtsc.ca",
    "ENVIRONMENT": "production",
    "FRONTEND_URL": "https://mtsc-seafarers-parcel.cloudgenz-it.workers.dev,https://parcelservice.mtsc.ca,http://localhost:5173"
  }
}
